{
  "version": 2,
  "builds": [
    {
      "src": "vercel-frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://finedge-iy0i.onrender.com/api/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "https://finedge-iy0i.onrender.com/admin/$1"
    },
    {
      "src": "/officer",
      "dest": "/vercel-frontend/officer/index.html"
    },
    {
      "src": "/officer/(.*)",
      "dest": "/vercel-frontend/officer/$1"
    },
    {
      "src": "/user",
      "dest": "/vercel-frontend/app/index.html"
    },
    {
      "src": "/user/(.*)",
      "dest": "/vercel-frontend/app/$1"
    },
    {
      "src": "/developer",
      "dest": "/vercel-frontend/index.html"
    },
    {
      "src": "/developer/(.*)",
      "dest": "/vercel-frontend/$1"
    },
    {
      "src": "/",
      "dest": "/vercel-frontend/index.html"
    }
  ]
}
